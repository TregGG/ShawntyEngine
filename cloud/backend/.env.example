NODE_ENV=production
# Generate with: openssl rand -hex 32
JWT_SECRET=
PORT=3001
HOST=127.0.0.1
# Number of reverse proxies in front of the app (1 for a single nginx/Caddy)
TRUST_PROXY=1
# Comma-separated; only needed if the frontend is on a different origin
CORS_ORIGINS=
# Database, uploads and runtime files. Keep outside the git checkout.
DATA_DIR=/var/lib/shawnty

# Game servers run user-supplied Python inside bubblewrap (bwrap). Off by default.
GAME_SERVERS_ENABLED=false
ENGINE_BIN=
# bwrap (development) or systemd (set up by deploy/setup-vm.sh; limits CPU and memory)
GAME_LAUNCHER=bwrap
PUBLIC_GAME_HOST=game.example.com
GAME_PORT_BASE=7777
RELOAD_PORT_BASE=9091
MAX_GAME_SERVERS=10
